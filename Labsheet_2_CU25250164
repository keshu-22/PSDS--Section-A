int main()
{
    int arr[100];
    int n, front, rear, value;
    char choice;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter array elements: ";
    for (int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }

    front = 0;
    rear = n - 1;

    cout << "Original queue: ";
    for (int i = front; i <= rear; i++)
    {
        cout << arr[i] << " ";
    }

    cout << "\n\nDo you want to enqueue an element? (y/n): ";
    cin >> choice;

    if (choice == 'y' || choice == 'Y')
    {
        cout << "Enter element to enqueue: ";
        cin >> value;

        enqueue(arr, front, rear, value);

        cout << "Queue after enqueue: ";
        for (int i = front; i <= rear; i++)
        {
            cout << arr[i] << " ";
        }
        cout << endl;
    }

    cout << "\nDo you want to dequeue an element? (y/n): ";
    cin >> choice;

    if (choice == 'y' || choice == 'Y')
    {
        dequeue(arr, front, rear);

        if (front != -1)
        {
            cout << "Queue after dequeue: ";
            for (int i = front; i <= rear; i++)
            {
                cout << arr[i] << " ";
            }
        }
        else
        {
            cout << "Queue is empty.";
        }

        cout << endl;
    }

    return 0;
}

#include <iostream>
using namespace std;

int linearSearch(int arr[], int n, int key)
{
    for (int i = 0; i < n; i++)
    {
        if (arr[i] == key)
        {
            return i;
        }
    }

    return -1;
}

int main()
{
    int arr[100];
    int n, key, result;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter array elements: ";
    for (int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }

    cout << "Enter element to search: ";
    cin >> key;

    result = linearSearch(arr, n, key);

    if (result != -1)
    {
        cout << "Element found at index " << result << endl;
    }
    else
    {
        cout << "Element not found." << endl;
    }

    return 0;
}

#include <iostream>
using namespace std;

int binarySearch(int arr[], int n, int key)
{
    int low = 0;
    int high = n - 1;

    while (low <= high)
    {
        int mid = (low + high) / 2;

        if (arr[mid] == key)
        {
            return mid;
        }
        else if (arr[mid] < key)
        {
            low = mid + 1;
        }
        else
        {
            high = mid - 1;
        }
    }

    return -1;
}

int main()
{
    int arr[100];
    int n, key, result;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements in sorted order: ";
    for (int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }

    cout << "Enter element to search: ";
    cin >> key;

    result = binarySearch(arr, n, key);

    if (result != -1)
    {
        cout << "Element found at index " << result << endl;
    }
    else
    {
        cout << "Element not found." << endl;
    }

    return 0;
}
